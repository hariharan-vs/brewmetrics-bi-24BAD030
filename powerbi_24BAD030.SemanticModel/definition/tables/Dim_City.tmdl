table Dim_City
	lineageTag: 9b2656e5-ae18-4bda-b532-15f95fd2c6a3

	measure 'MoM Sales Growth %' =
			
			VAR CurrentMonthSales =
			    SUM ( Fact_Sales[sales_amount] )
			VAR PreviousMonthSales =
			    CALCULATE (
			        SUM ( Fact_Sales[sales_amount] ),
			        DATEADD ( Dim_Date[date], -1, MONTH )
			    )
			RETURN
			    IF (
			        ISBLANK ( PreviousMonthSales ) || PreviousMonthSales = 0,
			        BLANK (),
			        DIVIDE (
			            CurrentMonthSales - PreviousMonthSales,
			            PreviousMonthSales
			        )
			    )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 590b4450-402d-4c3b-b6d9-2aba9777b4ea

	measure 'Running Total Sales' =
			
			VAR CurrentDate =
			    MAX ( Dim_Date[date] )
			RETURN
			    CALCULATE (
			        SUM ( Fact_Sales[sales_amount] ),
			        FILTER (
			            ALL ( Dim_Date ),
			            Dim_Date[date] <= CurrentDate
			        )
			    )
		lineageTag: 3b299c4a-e8bb-4817-8df2-fe0b099c5dc7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'City Sales Rank' =
			
			RANKX (
			    ALLSELECTED ( Dim_City[city] ),
			    CALCULATE ( SUM ( Fact_Sales[sales_amount] ) ),
			    ,
			    DESC,
			    DENSE
			)
		formatString: 0
		lineageTag: 52e2b09e-d5e5-43c4-b8e5-21d9a86949fe

	column city
		dataType: string
		lineageTag: 95e2c217-bc6b-4713-8c34-fbd8992786d9
		summarizeBy: none
		sourceColumn: city

		annotation SummarizationSetBy = Automatic

	partition Dim_City = m
		mode: import
		source =
				let
				    Source = Fact_Sales,
				    #"Removed Other Columns" = Table.SelectColumns(Source,{"city"}),
				    #"Removed Duplicates" = Table.Distinct(#"Removed Other Columns")
				in
				    #"Removed Duplicates"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

